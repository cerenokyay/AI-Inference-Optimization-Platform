APP_NAME="AI Inference Optimization Platform"
APP_VERSION=0.1.0

HOST=127.0.0.1
PORT=8000

DEBUG=true

LOG_LEVEL=INFO

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

REDIS_URL=redis://localhost:6379

CACHE_TTL=3600

# Vektör Önbellek Eşik Değerleri
SEMANTIC_THRESHOLD=0.85
DUPLICATE_THRESHOLD=0.99

DEFAULT_MODEL=qwen2.5:3b
DEFAULT_PROVIDER=ollama
PROVIDER_FALLBACK_CHAIN="openai,anthropic,ollama"